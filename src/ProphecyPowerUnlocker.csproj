<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><StartupObject>VictusPowerUnlockGui.Program</StartupObject>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols><PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Prophecy Power Unlocker</AssemblyName>
    <Product>Prophecy Power Unlocker</Product>
    <AssemblyTitle>Prophecy Power Unlocker</AssemblyTitle>
    <Version>1.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="OmenCore"><HintPath>..\lib\OmenCore.dll</HintPath></Reference><FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" /><PackageReference Include="System.Management" Version="10.0.2" /><PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" /><PackageReference Include="System.Diagnostics.EventLog" Version="9.0.0" />
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <PackageReference Include="LLT.NvAPIWrapper.Net" Version="1.1.24-pre.38" />
    <None Include="..\lib\drivers\PawnIOLib.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>drivers\PawnIOLib.dll</Link><ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Include="..\lib\drivers\RyzenSMU.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>drivers\RyzenSMU.bin</Link>
    </None>
  </ItemGroup>
</Project>
